<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_commune_finances" model="ir.module.category">
        <field name="name">Gestion Financière Commune</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_commune_user" model="res.groups">
        <field name="name">Utilisateur</field>
        <field name="category_id" ref="category_commune_finances"/>
    </record>

    <record id="group_commune_manager" model="res.groups">
        <field name="name">Responsable Financier</field>
        <field name="category_id" ref="category_commune_finances"/>
        <field name="implied_ids" eval="[(4, ref('group_commune_user'))]"/>
    </record>
</odoo>