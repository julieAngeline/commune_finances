<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_commune_recette_form" model="ir.ui.view">
        <field name="name">commune.recette.form</field>
        <field name="model">commune.recette</field>
        <field name="arch" type="xml">
            <form string="Recette">
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="numero_ordre_recette"/>
                            <field name="date_ordre_recette"/>
                            <field name="numero_declaration_recette"/>
                            <field name="date_declaration_recette"/>
                        </group>
                        <group string="Rattachement">
                            <field name="exercice_id"/>
                            <field name="compte_id"/>
                            <field name="regisseur_id"/>
                            <field name="categorie"/>
                        </group>
                    </group>
                    <group>
                        <group string="Versement">
                            <field name="date_versement"/>
                            <field name="montant"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="etat"/>
                        </group>
                        <group string="Période de versement">
                            <field name="periode_debut"/>
                            <field name="periode_fin"/>
                            <field name="periode_montant"/>
                        </group>
                    </group>
                    <group>
                        <field name="libelle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commune_recette_tree" model="ir.ui.view">
        <field name="name">commune.recette.tree</field>
        <field name="model">commune.recette</field>
        <field name="arch" type="xml">
            <tree>
                <field name="numero_ordre_recette"/>
                <field name="date_ordre_recette"/>
                <field name="regisseur_id"/>
                <field name="compte_id"/>
                <field name="categorie"/>
                <field name="etat"/>
                <field name="montant" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_commune_recette_kanban" model="ir.ui.view">
        <field name="name">commune.recette.kanban</field>
        <field name="model">commune.recette</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="numero_ordre_recette"/>
                <field name="regisseur_id"/>
                <field name="montant"/>
                <field name="etat"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <strong><field name="numero_ordre_recette"/></strong>
                            <div>Régisseur : <field name="regisseur_id"/></div>
                            <div>Montant : <field name="montant"/></div>
                            <div>État : <field name="etat"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_commune_recette_graph" model="ir.ui.view">
        <field name="name">commune.recette.graph</field>
        <field name="model">commune.recette</field>
        <field name="arch" type="xml">
            <graph string="Recettes par catégorie" type="bar">
                <field name="categorie" type="row"/>
                <field name="montant" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_commune_recette_search" model="ir.ui.view">
        <field name="name">commune.recette.search</field>
        <field name="model">commune.recette</field>
        <field name="arch" type="xml">
            <search>
                <field name="numero_ordre_recette"/>
                <field name="regisseur_id"/>
                <field name="compte_id"/>
                <filter string="Par catégorie" name="group_categorie" context="{'group_by': 'categorie'}"/>
                <filter string="Par régisseur" name="group_regisseur" context="{'group_by': 'regisseur_id'}"/>
                <filter string="Par état" name="group_etat" context="{'group_by': 'etat'}"/>
            </search>
        </field>
    </record>

    <record id="action_commune_recette" model="ir.actions.act_window">
        <field name="name">Recettes</field>
        <field name="res_model">commune.recette</field>
        <field name="view_mode">kanban,tree,form,graph</field>
    </record>

    <menuitem id="menu_commune_recette" name="Recettes" parent="menu_commune_finances_root" action="action_commune_recette" sequence="15"/>

</odoo>