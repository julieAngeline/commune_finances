<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_commune_regisseur_form" model="ir.ui.view">
        <field name="name">commune.regisseur.form</field>
        <field name="model">commune.regisseur</field>
        <field name="arch" type="xml">
            <form string="Régisseur">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="service"/>
                        <field name="matricule"/>
                        <field name="actif"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commune_regisseur_tree" model="ir.ui.view">
        <field name="name">commune.regisseur.tree</field>
        <field name="model">commune.regisseur</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="service"/>
                <field name="matricule"/>
                <field name="actif"/>
            </tree>
        </field>
    </record>

    <record id="action_commune_regisseur" model="ir.actions.act_window">
        <field name="name">Régisseurs</field>
        <field name="res_model">commune.regisseur</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_commune_regisseur" name="Régisseurs" parent="menu_commune_finances_root" action="action_commune_regisseur" sequence="30"/>

</odoo>