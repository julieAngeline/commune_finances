<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_commune_budget_depense_form" model="ir.ui.view">
        <field name="name">commune.budget.depense.form</field>
        <field name="model">commune.budget.depense</field>
        <field name="arch" type="xml">
            <form string="Budget de dépense">
                <sheet>
                    <group>
                        <field name="exercice_id"/>
                        <field name="compte_id"/>
                        <field name="prevision"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group string="Suivi budgétaire">
                        <field name="cumule"/>
                        <field name="disponible"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_commune_budget_depense_tree" model="ir.ui.view">
        <field name="name">commune.budget.depense.tree</field>
        <field name="model">commune.budget.depense</field>
        <field name="arch" type="xml">
            <tree>
                <field name="exercice_id"/>
                <field name="compte_id"/>
                <field name="prevision"/>
                <field name="cumule"/>
                <field name="disponible"/>
            </tree>
        </field>
    </record>

    <record id="action_commune_budget_depense" model="ir.actions.act_window">
        <field name="name">Budgets de dépense</field>
        <field name="res_model">commune.budget.depense</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_commune_budget_depense" name="Budgets" parent="menu_commune_finances_root" action="action_commune_budget_depense" sequence="7"/>
</odoo>